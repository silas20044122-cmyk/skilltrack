# ==============================================================================
# SkillTrack — Environment Configuration Template
# TVET Workplace Mentoring & Attachment Management System
# Copy this file to .env.local (or .env) for local development.
# NEVER commit the populated file. Never commit real credentials here.
# ==============================================================================

# Core Application Settings
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Supabase PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Option A — Local Postgres via Docker (recommended for development; no network
#   latency, no pooler). Start it with `npm run db:local:up`, then:
#     DATABASE_URL="postgresql://skilltrack:skilltrack@localhost:5432/skilltrack"
#     DIRECT_URL="postgresql://skilltrack:skilltrack@localhost:5432/skilltrack"
#   Apply migrations with `npm run db:migrate` and seed with `npm run db:seed`.
#
# Option B — Hosted Supabase (use for staging/production, or dev against cloud).
# NOTE: Supabase's connection pooler requires the tenant in the username as
#   postgres.<project-ref> (not just "postgres"). Using a bare "postgres"
#   username makes the pooler return "(ENOIDENTIFIER) no tenant identifier".
# DATABASE_URL: Prisma Client runtime connection.
#   Local / long-lived server  -> session pooler, port 5432 (can hold connections).
#   Vercel / serverless        -> transaction pooler, port 6543 + connection_limit=1.
#   Session mode caps the whole project at 15 clients; each serverless instance
#   opens its own pool, so on Vercel it exhausts quickly with
#   "(EMAXCONNSESSION) max clients reached in session mode". ALWAYS use 6543 on
#   Vercel. `pgbouncer=true` is required so Prisma disables prepared statements.
# Local development (session pooler):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Vercel / serverless (transaction pooler) — set this in the Vercel dashboard:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: Session connection string (Prisma CLI migrations/introspection only;
# never used by runtime queries, so it does not consume the serverless budget).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# Supabase API (Client & Server keys)
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are used by the
# server-only storage driver. The service-role key must NEVER be exposed to the
# client and is only read on the server.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Private bucket that holds source mentoring-tool PDFs. Created automatically at
# runtime; the file must be stored privately (no public URLs).
SUPABASE_STORAGE_BUCKET="mentoring-documents"

# Authentication Configuration (Auth.js v5)
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL=http://localhost:3000
# Required when self-hosting a production build (next start): Auth.js only
# auto-trusts the host in dev. Without this, production requests to /api/auth/*
# fail with 500 PERMISSION_DENIED/UntrustedHost. Ignored in development.
AUTH_TRUST_HOST=true

# AI / Gemini API Integration (server-side secret)
GEMINI_API_KEY="your-gemini-api-key"
# Model used for document extraction. Configuration-driven so a new model can be
# adopted without a code change.
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# Development seed accounts (documentation only — NOT read from env)
# Defined in lib/auth/user-store.ts and prisma/seed.ts. Local/test use only:
#   admin@skilltrack.gov.tvet    / AdminPass123!    (ADMIN)
#   mentor@workplace.co.ke       / MentorPass123!   (MENTOR)
#   trainee@polytechnic.ac.ke    / TraineePass123!  (TRAINEE)
#   ilo@institute.ac.ke          / IloPass123!      (ILO)
#   coordinator@polytechnic.ac.ke/ CoordPass123!    (ADMIN + ILO)
#   inactive@polytechnic.ac.ke   / InactivePass123! (INACTIVE — must be rejected)
#   mentor2@workplace.co.ke      / Mentor2Pass123!  (MENTOR)
#   trainee2@polytechnic.ac.ke   / Trainee2Pass123! (TRAINEE)
#   trainee3@polytechnic.ac.ke   / Trainee3Pass123! (TRAINEE)
# ------------------------------------------------------------------------------